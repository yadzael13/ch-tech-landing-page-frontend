# =========================
# Ports
# =========================
FRONTEND_PORT=3000

# =========================
# Backend API (docs/API.md)
# =========================
# This repo no longer shares a Docker Compose network with the backend
# (ch-tech-landing-page-backend is a separate repo/project) — both URLs
# point at plain localhost in local dev now, whether the frontend runs via
# `npm run dev` or its own optional Docker container run with --network host.
# In production, both point at the real backend domain.

# Browser-facing (client-side fetches, e.g. the Contact form).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Server-side only (Next.js Server Components fetch calls).
API_URL=http://localhost:8000/api/v1
# Public site URL — used for metadataBase, robots.txt, and sitemap.xml
# (lib/content/metadata.ts, app/robots.ts, app/sitemap.ts). Set this to the
# real production domain when deploying; no domain is hardcoded in code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
